@model IEnumerable<ProductListItemDto>

@{
    ViewData["Title"] = "Ürünler";
}

<div class="container-fluid py-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold">Ürünler</h1>
            <p class="text-muted">@Model.Count() ürün bulundu</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <a href="@Url.Action("Details", "Products", new { id = product.Id })" class="text-decoration-none">
                        <div class="card h-100 shadow-sm border-0 overflow-hidden card-hover">
                            <!-- Ürün Görseli -->
                            <div class="position-relative bg-light" style="height: 200px; overflow: hidden;">
                                @if (!string.IsNullOrEmpty(product.CoverImageUrl))
                                {
                                    <img src="@product.CoverImageUrl" alt="@product.Name" class="w-100 h-100 object-fit-cover">
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                                        <i class="fas fa-image text-muted" style="font-size: 3rem;"></i>
                                    </div>
                                }

                                <!-- İndirim Badge -->
                                @if (product.DiscountRate > 0)
                                {
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2">
                                        <i class="fas fa-tag"></i> -%@product.DiscountRate
                                    </span>
                                }
                            </div>

                            <!-- Ürün Bilgileri -->
                            <div class="card-body d-flex flex-column">
                                <!-- Kategori -->
                                <div class="mb-2">
                                    <small class="text-muted">
                                        <i class="fas fa-folder"></i> @product.CategoryName / @product.SubcategoryName
                                    </small>
                                </div>

                                <!-- Marka -->
                                <small class="text-primary fw-semibold mb-2">
                                    <i class="fas fa-building"></i> @product.BrandName
                                </small>

                                <h5 class="card-title">
                                    @product.Name
                                </h5>

                                <!-- Puan ve Yorum -->
                                <div class="mb-3 small">
                                    <div class="mb-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            @if (i <= product.Rating)
                                            {
                                                <i class="fas fa-star text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-secondary"></i>
                                            }
                                        }
                                        <span class="ms-1 text-muted">(@product.ReviewCount)</span>
                                    </div>
                                </div>

                                <!-- Fiyat Bilgileri -->
                                <div class="mt-auto">
                                    @if (product.DiscountRate > 0)
                                    {
                                        <div class="mb-2">
                                            <span class="text-decoration-line-through text-muted">
                                                ₺@product.Price.ToString("F2")
                                            </span>
                                        </div>
                                        <h6 class="mb-0">
                                            <span class="text-success fw-bold">₺@product.DiscountPrice.ToString("F2")</span>
                                        </h6>
                                    }
                                    else
                                    {
                                        <h6 class="mb-0">
                                            <span class="fw-bold">₺@product.Price.ToString("F2")</span>
                                        </h6>
                                    }
                                </div>
                            </div>

                            <!-- Buton -->
                            <div class="card-footer bg-transparent border-top-0 p-3">
                                <button class="btn btn-primary w-100 btn-sm">
                                    <i class="fas fa-shopping-cart"></i> Sepete Ekle
                                </button>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> Ürün bulunamadı.
        </div>
    }
</div>

<style>
    .card-hover {
        transition: all 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important;
        }
</style>
<!-- Product Details sayfasını yap! Ödev!!! -->